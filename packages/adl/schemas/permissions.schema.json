{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/permissions/v0.1.json",
  "title": "Axiom Permissions v0.1",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "permissions": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "object",
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          }
        },
        "terminal": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allow": { "type": "array", "items": { "type": "string" } },
            "deny": { "type": "array", "items": { "type": "string" } }
          }
        },
        "network": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } }
        },
        "secrets": {
          "type": "object",
          "properties": { "access": { "enum": ["none", "read", "write"] } }
        }
      }
    }
  }
}